#include <stdbool.h>
#include <stdlib.h>
#include <math.h>

bool dfs(int** heights, int r, int c, int rows, int cols, int limit, bool** visited) {
    if (r == rows - 1 && c == cols - 1) return true;
    visited[r][c] = true;
    
    int dr[] = {-1, 1, 0, 0};
    int dc[] = {0, 0, -1, 1};
    
    for (int i = 0; i < 4; i++) {
        int nr = r + dr[i];
        int nc = c + dc[i];
        
        if (nr >= 0 && nr < rows && nc >= 0 && nc < cols && !visited[nr][nc]) {
            int diff = abs(heights[r][c] - heights[nr][nc]);
            if (diff <= limit) {
                if (dfs(heights, nr, nc, rows, cols, limit, visited)) return true;
            }
        }
    }
    return false;
}

bool canReach(int** heights, int rows, int cols, int limit) {
    bool** visited = (bool**)malloc(rows * sizeof(bool*));
    for (int i = 0; i < rows; i++) {
        visited[i] = (bool*)calloc(cols, sizeof(bool));
    }
    
    bool result = dfs(heights, 0, 0, rows, cols, limit, visited);
    
    for (int i = 0; i < rows; i++) {
        free(visited[i]);
    }
    free(visited);
    
    return result;
}

int minimumEffortPath(int** heights, int heightsSize, int* heightsColSize) {
    int rows = heightsSize;
    int cols = heightsColSize[0];
    
    int low = 0, high = 1000000;
    int ans = high;
    
    while (low <= high) {
        int mid = low + (high - low) / 2;
        if (canReach(heights, rows, cols, mid)) {
            ans = mid;
            high = mid - 1; // Try to find a smaller maximum effort
        } else {
            low = mid + 1;  // Need more effort
        }
    }
    
    return ans;
}
