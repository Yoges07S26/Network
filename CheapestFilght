#include <stdlib.h>
#include <string.h>
#define INF 1e9
int findCheapestPrice(int n, int** flights, int flightsSize, int* flightsColSize, int src, int dst, int k) {
    int* dist = (int*)malloc(n * sizeof(int));
    int* prev_dist = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        dist[i] = INF;
    }
    dist[src] = 0;
    for (int i = 0; i <= k; i++) {
        memcpy(prev_dist, dist, n * sizeof(int));
        for (int j = 0; j < flightsSize; j++) {
            int u = flights[j][0]; 
            int v = flights[j][1]; 
            int price = flights[j][2]; 
            if (prev_dist[u] != INF) {
                if (prev_dist[u] + price < dist[v]) {
                    dist[v] = prev_dist[u] + price;
                }
            }
        }
    }
    int result = dist[dst];
    free(dist);
    free(prev_dist);
    return (result == INF) ? -1 : result;
}
